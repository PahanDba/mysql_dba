[Unit]
Description=This timer unit is for data_top_mysql export
Requires=data_top_mysql.service

[Timer]
Unit=data_top_mysql.service
OnCalendar=*:*:0/5
AccuracySec=1ms

[Install]
WantedBy=timers.target
